source "https://rubygems.org"

# GitHub Pages bundles a pinned version of Jekyll plus the supported plugins.
# See https://pages.github.com/versions/ for the current versions.
gem "github-pages", group: :jekyll_plugins

# Tzinfo data for Windows / JRuby compatibility.
gem "tzinfo-data", platforms: [:mingw, :x64_mingw, :mswin, :jruby]
gem "wdm", "~> 0.1.1", :platforms => [:mingw, :x64_mingw, :mswin]

# Performance booster for watching directories on Linux.
gem "http_parser.rb", "~> 0.6.0", :platforms => [:jruby]
